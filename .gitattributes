# Force LF for every text file — in the repo AND on checkout (Windows too) —
# so generated-file checks (gen-tokens --check), the pwsh gate scripts and
# svelte-check behave identically on every machine and on CI. A Windows
# checkout with core.autocrlf=true was handing CI CRLF copies and failing
# the token drift gate.
* text=auto eol=lf

# Binary assets — git must never apply line-ending conversion to these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.zip   binary
*.gltf  binary
*.glb   binary
